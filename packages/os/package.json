{
  "name": "@dreamdesk/os",
  "version": "0.1.0",
  "description": "The OS layer for DreamDesk: a virtual filesystem with a recycle bin, processes with windows, file types, remembered app state, and a DOS shell.",
  "keywords": [
    "dreamdesk",
    "desktop",
    "os",
    "virtual-filesystem",
    "recycle-bin",
    "shell",
    "dos",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stonedem0/dreamdesk.git",
    "directory": "packages/os"
  },
  "homepage": "https://github.com/stonedem0/dreamdesk/tree/master/packages/os#readme",
  "bugs": {
    "url": "https://github.com/stonedem0/dreamdesk/issues"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
